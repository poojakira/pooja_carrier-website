# Career OS authentication. Both values must be at least 32 random characters.
# Generate independently, for example with: openssl rand -hex 32
CAREER_OS_ACCESS_KEY=replace-with-a-random-access-key
CAREER_OS_SESSION_SECRET=replace-with-a-different-random-session-secret

# Optional AI provider configuration.
OPENAI_API_KEY=replace-with-your-provider-key
OPENAI_MODEL=gpt-4o-mini

# Optional SMTP delivery. There is no hard-coded recipient fallback.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=replace-with-an-app-password
NOTIFICATION_EMAIL=you@example.com
